# Copy this file to .env before the first `docker compose up`.
# Use a long random value; the database is not published outside Compose, but
# this still protects it from other containers on the host.
HEXZ_POSTGRES_PASSWORD=replace-with-a-long-random-password

# The Go endpoint is the only port published by the Compose application.
HEXZ_BIND_ADDRESS=0.0.0.0
HEXZ_PORT=8080
HEXZ_URL_PATH_PREFIX=/hexzml
